{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "internal-evol-staging",
  "account_id": "b688d3fbe276f621033a23dce40c22fa",
  "main": ".open-next/worker.js",
  "workers_dev": true,
  "compatibility_date": "2026-08-21",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "NEXT_PUBLIC_APP_URL": "https://internal-evol-staging.arihant-jain.workers.dev",
    "NEXT_PUBLIC_API_BASE_URL": "https://evol-backend-staging.onrender.com",
    "NEXT_PUBLIC_AUTH_BASE_URL": "https://evol-backend-staging.onrender.com/api/v1/auth"
  },
  "observability": {
    "enabled": true
  }
}
